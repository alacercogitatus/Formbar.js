{
	"name": "formbar",
	"version": "1.0.0",
	"description": "Javascript rewrite of Formbar, an open source classroom management tool",
	"main": "app.js",
	"scripts": {
		"jest": "jest --detectOpenHandles",
		"dev": "nodemon app",
		"start": "node app",
		"dep_check": "tests/dependency-check/bin/dependency-check.sh --project Formbar.js --log logs/dep_check.log --junitFailOnCVSS 6 -f JUNIT -f HTML -s ./routes -s ./views -s ./app.js -s ./static --out ./tests/reports/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alacercogitatus/Formbar.js.git"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/alacercogitatus/Formbar.js/issues"
	},
	"homepage": "https://github.com/alacercogitatus/Formbar.js#readme",
	"nodemonConfig": {
		"ignore": [
			"settings.json",
			"logNumbers.json",
			"static/**"
		]
	},
	"dependencies": {
		"@floating-ui/dom": "^1.5.3",
		"@jaames/iro": "^5.5.2",
		"chart.js": "^4.4.0",
		"convert-excel-to-json": "^1.7.0",
		"ejs": "^3.1.8",
		"express": "^4.18.2",
		"express-session": "^1.17.3",
		"htmlparser": "^1.7.7",
		"init": "^0.1.2",
		"jsonwebtoken": "^9.0.0",
		"multer": "^1.4.5-lts.1",
		"node-html-parser": "^7.0.1",
		"socket.io": "^4.5.4",
		"sqlite3": "^5.1.6",
		"winston": "^3.17.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"nodemon": "^3.0.1",
		"jest": "^29.7.0",
		"@types/jest": "^29.5.14"
	}
}
